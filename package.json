{
  "name": "event-driven-order-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Microservices e-commerce backend that keeps orders, payments and inventory consistent with an orchestrated Saga over Kafka.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"packages/*/test/*.test.js\" \"services/*/test/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 test/integration/*.test.js",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 test/e2e/*.test.js",
    "demo": "sh scripts/demo.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "ioredis": "^5.11.1"
  },
  "license": "MIT"
}
